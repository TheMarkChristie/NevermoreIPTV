<?xml version="1.0" encoding="utf-8"?>
<!-- The app's own dark (#101114) behind the window until Flutter draws its first frame. (No bitmap here: the launcher
     icon is an adaptive-icon XML on API 26+, which a bitmap item cannot show, and the window would fail to open.) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
</layer-list>