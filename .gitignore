# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Never in the repo: logins, and the release key (kept outside the project; android/key.properties says where)
.env
android/key.properties
*.jks
*.keystore

# Built APKs handed out (large; rebuilt from the code)
/releases/

# WireGuard settings carry a private key
*.conf

# The working design notes stay local: they describe one household's provider, account and homes
/docs/
